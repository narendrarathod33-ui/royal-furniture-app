# Required ONLY by the production static server (npm start).
# Replace with the exact public HTTPS frontend origin; no trailing slash.
# This is public configuration, not a credential. Startup fails while empty.
APP_ORIGIN=
# Optional: defaults to 8080; must be an integer from 1 to 65535.
PORT=8080
# No API keys, database URL or authentication secret are required by this client.
# Never add private credentials to EXPO_PUBLIC_*, NEXT_PUBLIC_* or REACT_APP_*.
# Real backend credentials belong only in a separately deployed backend.

# Optional hosted Stripe SANDBOX checkout. Disabled by default.
# Server-only: never use EXPO_PUBLIC_/NEXT_PUBLIC_/REACT_APP_ for these keys.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: shared secret for the local live-catalog push receiver
# (data/tools/drive_receiver.mjs). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Keep the real value out of source control and out of client code.
RECEIVER_TOKEN=
